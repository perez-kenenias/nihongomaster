        {"kanji": "売店", "kana": "ばいてん", "es": "tienda / kiosko"},
        {"kanji": "地下", "kana": "ちか", "es": "sótano"},
        {"kanji": "～階", "kana": "～かい / ～がい", "es": "piso ~ (edificio)"}
      ],
      "sentences": [
        {"jp": "ここは教室です。", "es": "Aquí es el aula."},
        {"jp": "トイレはあそこです。", "es": "El baño está allí."},
        {"jp": "受付はロビーにあります。", "es": "La recepción está en el vestíbulo."},
        {"jp": "事務所は2階です。", "es": "La oficina está en el segundo piso."},
        {"jp": "食堂はどこですか。", "es": "¿Dónde está el comedor?"},
        {"jp": "すみません、エレベーターはどこですか。", "es": "Disculpe, ¿dónde está el ascensor?"}
      ]
    },
    {
      "id": "mnn_l04",
      "title": "L4: 今 何時ですか",
      "grammar": ["時間の表現", "Vます (presente/futuro)", "Vません (negativo)", "N(時)にV"],
      "vocabulary": [
        {"kanji": "今", "kana": "いま", "es": "ahora"},
        {"kanji": "午前", "kana": "ごぜん", "es": "AM / mañana"},
        {"kanji": "午後", "kana": "ごご", "es": "PM / tarde"},
        {"kanji": "起きます", "kana": "おきます", "es": "levantarse"},
        {"kanji": "寝ます", "kana": "ねます", "es": "dormir / acostarse"},
        {"kanji": "働きます", "kana": "はたらきます", "es": "trabajar"},
        {"kanji": "休みます", "kana": "やすみます", "es": "descansar / tomar vacaciones"},
        {"kanji": "勉強します", "kana": "べんきょうします", "es": "estudiar"},
        {"kanji": "終わります", "kana": "おわります", "es": "terminar"},
        {"kanji": "行きます", "kana": "いきます", "es": "ir"},
        {"kanji": "来ます", "kana": "きます", "es": "venir"},
        {"kanji": "帰ります", "kana": "かえります", "es": "regresar / volver a casa"},
        {"kanji": "朝", "kana": "あさ", "es": "mañana"},
        {"kanji": "昼", "kana": "ひる", "es": "mediodía"},
        {"kanji": "晩 / 夜", "kana": "ばん / よる", "es": "noche"},
        {"kanji": "毎日", "kana": "まいにち", "es": "todos los días"},
        {"kanji": "何時", "kana": "なんじ", "es": "qué hora"},
        {"kanji": "何分", "kana": "なんぷん", "es": "qué minuto"},
        {"kanji": "～から～まで", "kana": "～から～まで", "es": "desde ~ hasta ~"},
        {"kanji": "試験", "kana": "しけん", "es": "examen"},
        {"kanji": "たいへん", "kana": "たいへん", "es": "duro / difícil (situación)"}
      ],
      "sentences": [
        {"jp": "今何時ですか。", "es": "¿Qué hora es ahora?"},
        {"jp": "午前7時です。", "es": "Son las 7 AM."},
        {"jp": "毎日勉強します。", "es": "Estudio todos los días."},
        {"jp": "私は9時から5時まで働きます。", "es": "Trabajo de 9 a 5."},
        {"jp": "明日休みます。", "es": "Mañana descanso."},
        {"jp": "何時に起きますか。", "es": "¿A qué hora te levantas?"},
        {"jp": "7時に起きます。", "es": "Me levanto a las 7."}
      ]
    },
    {
      "id": "mnn_l05",
      "title": "L5: あの電車は 大阪へ行きます",
