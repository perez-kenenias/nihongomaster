{
  "id": "minna_no_nihongo",
  "title": "Minna no Nihongo Shokyuu I",
  "description": "Curso introductorio de japonés — 25 lecciones del libro principal",
  "lessons": [
    {
      "id": "mnn_l01",
      "title": "L1: わたしは マイク・ミラーです",
      "grammar": ["N1はN2です", "N1はN2じゃありません", "N1のN2", "～さん (honorífico)"],
      "vocabulary": [
        {"kanji": "私", "kana": "わたし", "es": "yo"},
        {"kanji": "私たち", "kana": "わたしたち", "es": "nosotros"},
        {"kanji": "あなた", "kana": "あなた", "es": "tú / usted"},
        {"kanji": "あの人", "kana": "あのひと", "es": "esa persona / él / ella"},
        {"kanji": "先生", "kana": "せんせい", "es": "profesor / maestro"},
        {"kanji": "教師", "kana": "きょうし", "es": "profesor (título)"},
        {"kanji": "学生", "kana": "がくせい", "es": "estudiante"},
        {"kanji": "会社員", "kana": "かいしゃいん", "es": "empleado de empresa"},
        {"kanji": "銀行員", "kana": "ぎんこういん", "es": "empleado bancario"},
        {"kanji": "医者", "kana": "いしゃ", "es": "médico"},
