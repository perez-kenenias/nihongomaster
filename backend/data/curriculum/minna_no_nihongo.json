        {"kanji": "日本語", "kana": "にほんご", "es": "idioma japonés"},
        {"kanji": "英語", "kana": "えいご", "es": "idioma inglés"},
        {"kanji": "違います", "kana": "ちがいます", "es": "es diferente / no es correcto"}
