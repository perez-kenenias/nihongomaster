      "sentences": [
        {"jp": "私はマイク・ミラーです。", "es": "Soy Mike Miller."},
        {"jp": "私は学生です。", "es": "Soy estudiante."},
        {"jp": "私は会社員じゃありません。", "es": "No soy empleado de empresa."},
        {"jp": "私は医者です。", "es": "Soy médico."},
        {"jp": "マイクさんは先生ですか。", "es": "¿Mike es profesor?"},
        {"jp": "これは私の本です。", "es": "Este es mi libro."}
      ]
    },
    {
      "id": "mnn_l02",
      "title": "L2: これは 本です",
      "grammar": ["これ/それ/あれ", "このN/そのN/あのN", "そうです/違います"],
      "vocabulary": [
        {"kanji": "これ", "kana": "これ", "es": "esto (cerca del hablante)"},
        {"kanji": "それ", "kana": "それ", "es": "eso (cerca del oyente)"},
        {"kanji": "あれ", "kana": "あれ", "es": "aquello (lejos de ambos)"},
        {"kanji": "本", "kana": "ほん", "es": "libro"},
        {"kanji": "辞書", "kana": "じしょ", "es": "diccionario"},
