        {"kanji": "誰", "kana": "だれ", "es": "quién"},
        {"kanji": "何歳", "kana": "なんさい / おいくつ", "es": "qué edad"},
        {"kanji": "初めまして", "kana": "はじめまして", "es": "mucho gusto (por primera vez)"},
        {"kanji": "～から来ました", "kana": "～からきました", "es": "vengo de ~"},
        {"kanji": "日本", "kana": "にほん", "es": "Japón"},
        {"kanji": "アメリカ", "kana": "アメリカ", "es": "Estados Unidos"},
        {"kanji": "ブラジル", "kana": "ブラジル", "es": "Brasil"},
        {"kanji": "どうぞ宜しく", "kana": "どうぞよろしく", "es": "encantado / mucho gusto"}
