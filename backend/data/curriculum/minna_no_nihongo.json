      "sentences": [
        {"jp": "これは本です。", "es": "Esto es un libro."},
        {"jp": "それは私の傘です。", "es": "Eso es mi paraguas."},
        {"jp": "あれは病院です。", "es": "Aquello es un hospital."},
        {"jp": "これは日本語の本ですか。", "es": "¿Es este un libro de japonés?"},
        {"jp": "それは辞書ですか。", "es": "¿Es eso un diccionario?"},
        {"jp": "いいえ、違います。雑誌です。", "es": "No, es diferente. Es una revista."}
      ]
    },
    {
      "id": "mnn_l03",
      "title": "L3: ここは 教室です",
      "grammar": ["ここ/そこ/あそこ", "Nは場所です", "N1のN2（場所）"],
      "vocabulary": [
        {"kanji": "ここ", "kana": "ここ", "es": "aquí"},
        {"kanji": "そこ", "kana": "そこ", "es": "ahí"},
        {"kanji": "あそこ", "kana": "あそこ", "es": "allí"},
