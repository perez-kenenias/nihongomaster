      "sentences": [
        {"jp": "私は電車で大阪へ行きます。", "es": "Voy a Osaka en tren."},
        {"jp": "友達と日本へ行きます。", "es": "Voy a Japón con un amigo."},
        {"jp": "いつ日本へ来ますか。", "es": "¿Cuándo vienes a Japón?"},
        {"jp": "来月日本へ来ます。", "es": "Vengo a Japón el próximo mes."},
        {"jp": "バスで会社へ行きます。", "es": "Voy a la empresa en autobús."},
        {"jp": "昨日電車で帰りました。", "es": "Ayer regresé en tren."},
        {"jp": "家族と日本へ来ました。", "es": "Vine a Japón con mi familia."}
