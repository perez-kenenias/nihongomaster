      "sentences": [
        {"jp": "私はメアリーです。", "es": "Soy Mary."},
        {"jp": "たけしさんは日本人です。", "es": "Takeshi es japonés."},
        {"jp": "私は留学生です。", "es": "Soy estudiante internacional."},
        {"jp": "メアリーさんはアメリカ人ですか。", "es": "¿Mary es estadounidense?"},
        {"jp": "専門は歴史です。", "es": "Mi especialidad es historia."},
        {"jp": "お名前は何ですか。", "es": "¿Cuál es tu nombre?"}
      ]
    },
    {
      "id": "genki1_l02",
      "title": "L2: 買い物 (De compras)",
      "grammar": ["これ/それ/あれ/どれ", "この/その/あの/どの", "ここ/そこ/あそこ/どこ", "だれの", "も", "～じゃないです"],
      "vocabulary": [
        {"kanji": "これ", "kana": "これ", "es": "esto"},
        {"kanji": "それ", "kana": "それ", "es": "eso"},
        {"kanji": "あれ", "kana": "あれ", "es": "aquello"},
        {"kanji": "どれ", "kana": "どれ", "es": "cuál"},
        {"kanji": "何", "kana": "なに/なん", "es": "qué"},
        {"kanji": "いくら", "kana": "いくら", "es": "cuánto (precio)"},
        {"kanji": "本", "kana": "ほん", "es": "libro"},
        {"kanji": "辞書", "kana": "じしょ", "es": "diccionario"},
        {"kanji": "お土産", "kana": "おみやげ", "es": "recuerdo / souvenir"},
