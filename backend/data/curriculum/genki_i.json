        {"kanji": "国際関係", "kana": "こくさいかんけい", "es": "relaciones internacionales"},
        {"kanji": "電話番号", "kana": "でんわばんごう", "es": "número de teléfono"},
        {"kanji": "名前", "kana": "なまえ", "es": "nombre"},
        {"kanji": "国", "kana": "くに", "es": "país"},
