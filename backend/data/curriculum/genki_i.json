        {"kanji": "韓国人", "kana": "かんこくじん", "es": "coreano (persona)"},
        {"kanji": "専門", "kana": "せんもん", "es": "especialidad / carrera"},
        {"kanji": "経済", "kana": "けいざい", "es": "economía"},
