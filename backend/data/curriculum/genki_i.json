        {"kanji": "会う", "kana": "あう", "es": "encontrarse con / ver a alguien"}
      ],
      "sentences": [
        {"jp": "私は毎日コーヒーを飲みます。", "es": "Bebo café todos los días."},
        {"jp": "図書館で本を読みます。", "es": "Leo libros en la biblioteca."},
        {"jp": "喫茶店に行きませんか。", "es": "¿Vamos a un café?"},
        {"jp": "映画を見ましょう。", "es": "Veamos una película."},
        {"jp": "昨日手紙を書きました。", "es": "Ayer escribí una carta."},
        {"jp": "朝ごはんを食べませんでした。", "es": "No desayuné."}
      ]
    }
  ]
